# Copy to .env for local development. Never commit real secrets.
KOYALA_DATABASE_URL=postgresql+psycopg://koyala:koyala-dev-only@localhost:5432/koyala
# Generate with: python -c "from koyala.db.crypto import Crypto; print(Crypto.generate_key())"
KOYALA_MASTER_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KOYALA_JWT_SECRET=
KOYALA_LLM_PROVIDER=stub
# ANTHROPIC_API_KEY=
# Shared secret the crisis partner sends as X-Partner-Token
KOYALA_PARTNER_TOKEN=
